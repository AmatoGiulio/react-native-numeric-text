<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn here rather than taken from an icon set. Filled rather than stroked: a stroked arc with
     a transparent fill did not render at all under Compose's Icon tint, leaving only the arrow
     head on screen. This is a 2dp-thick ring segment built from an outer and an inner arc, which
     tints and scales predictably. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
  <!-- Ring from the top point, three quarters of the way round, ending at the right point. -->
  <path android:fillColor="#FF000000"
        android:pathData="M12,4 A8,8 0 1,0 20,12 L18,12 A6,6 0 1,1 12,6 Z" />
  <!-- Head at the top, pointing along the direction of travel. -->
  <path android:fillColor="#FF000000"
        android:pathData="M11.2,0.8 L11.2,7.2 L16.4,4 Z" />
</vector>
